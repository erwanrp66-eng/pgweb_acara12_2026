          </se:PointSymbolizer>
        </se:Rule>
        <se:Rule>
          <se:Name>SKB</se:Name>
          <se:Description>
            <se:Title>SKB</se:Title>
          </se:Description>
          <ogc:Filter xmlns:ogc="http://www.opengis.net/ogc">
