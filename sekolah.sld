      <se:FeatureTypeStyle>
        <se:Rule>
          <se:Name>Kursus</se:Name>
          <se:Description>
            <se:Title>Kursus</se:Title>
          </se:Description>
          <ogc:Filter xmlns:ogc="http://www.opengis.net/ogc">
