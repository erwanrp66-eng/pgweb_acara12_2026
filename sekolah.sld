          </se:PointSymbolizer>
        </se:Rule>
        <se:Rule>
          <se:Name>Pondok Pesantren</se:Name>
          <se:Description>
            <se:Title>Pondok Pesantren</se:Title>
          </se:Description>
          <ogc:Filter xmlns:ogc="http://www.opengis.net/ogc">
            <ogc:PropertyIsEqualTo>
              <ogc:PropertyName>jenjang</ogc:PropertyName>
